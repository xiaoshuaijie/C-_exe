{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc.exe 构建协议示例",
            "command": "E:\\vscode\\mingw64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c17",
                "-Wall",
                "-Wextra",
                "${fileDirname}\\main.c",
                "${fileDirname}\\crc_ref.c",
                "-o",
                "${fileDirname}\\main.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "编译器: E:\\vscode\\mingw64\\bin\\gcc.exe"
        },
        {
            "type": "shell",
            "label": "C/C++: g++.exe 生成活动文件 (C++17)",
            "command": "E:\\vscode\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "C++17 编译器: E:\\vscode\\mingw64\\bin\\g++.exe"
        }
    ]
}